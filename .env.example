NEXT_PUBLIC_WORDPRESS_URL="https://sysblok.ru"
NEXT_PUBLIC_URL="https://next.sysblok.team"
# For the revalidate plugin
# You can generate by running `openssl rand -base64 32` in the terminal
NEXT_WORDPRESS_WEBHOOK_SECRET="your-secret-key-here"
SSL_CERTS=./certificates

# Auth: WordPress login slug (change if using a custom login URL plugin)
WORDPRESS_LOGIN_SLUG="wp-login.php"
# Auth: shared secret for WP headless auth code exchange (generate with: openssl rand -base64 32)
WP_AUTH_SHARED_SECRET="your-auth-secret-here"
# Auth: secret for encrypting session cookies (generate with: openssl rand -base64 32)
AUTH_SESSION_SECRET="your-session-secret-here"